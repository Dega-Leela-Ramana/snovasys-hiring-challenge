# Copy this file to server/.env and fill it in.
# server/.env is git-ignored. NEVER commit real values.

NODE_ENV=development
PORT=4000

# Main database and a SEPARATE test database. The test database name must
# contain the word "test": the test suite wipes it and refuses to run otherwise.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/trustvault
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/trustvault_test

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

SESSION_MAX_AGE_HOURS=8

# How many reverse proxies sit in front of the app.
# 0 on your laptop. Usually 1 on Render / Railway / Fly. See DEPLOY.md.
TRUST_PROXY=0

# Extra browser origins allowed to make state-changing requests (normally empty).
ALLOWED_ORIGINS=

# Used only by `npm run seed`. Choose your own passwords (12+ characters).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
